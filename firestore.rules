rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User hanya boleh membaca & mengubah dokumen profilnya sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sekalian melindungi sub-koleksi di bawah user (misal nanti ada dompet/transaksi/target)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}