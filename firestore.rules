rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User hanya boleh membaca & mengubah dokumen profilnya sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sekalian melindungi sub-koleksi di bawah user (misal nanti ada dompet/transaksi/target)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    // Materi & kuis Ruang Belajar: semua pengguna yang login boleh membaca,
    // tidak ada yang boleh menulis dari aplikasi (isi diubah lewat skrip seed / Console).
    match /belajar_levels/{levelId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /belajar_modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}